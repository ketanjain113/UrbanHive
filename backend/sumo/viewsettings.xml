<viewsettings>
    <scheme name="urbanhive">
        <background backgroundColor="20,25,35" showGrid="0"/>
        
        <edges laneEdgeMode="0" scaleSize="1"
               showLinkDecals="1" showLinks="1"
               hideConnectors="0" widthExaggeration="3.0"
               laneShowBorders="1">
            <colorScheme name="uniform">
                <entry color="40,60,80"/>
            </colorScheme>
        </edges>

        <lanes laneEdgeMode="0" scaleSize="1"
               showLinkDecals="1" widthExaggeration="3.0"
               laneShowBorders="0">
            <colorScheme name="by speed">
                <entry color="220,50,50"  value="0.0"/>
                <entry color="240,160,20" value="4.0"/>
                <entry color="30,200,80"  value="8.0"/>
            </colorScheme>
        </lanes>

        <vehicles vehicleMode="0" vehicleQuality="2"
                  minVehicleSize="8.0" vehicleExaggeration="4.0"
                  showBlinker="1" drawMinGap="0">
            <colorScheme name="given/assigned vehicle color"/>
        </vehicles>

        <junctions drawShape="1" drawCrossingsAndWalkingareas="1">
            <colorScheme name="uniform">
                <entry color="50,70,90"/>
            </colorScheme>
        </junctions>

        <tractionLinks/>
        <legend showSizeLegend="0" showColorLegend="0"/>
    </scheme>
</viewsettings>
